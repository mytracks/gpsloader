      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über gpsloader"
          }
        }
      }
    },
    "Another operation is already using %@. Wait until it has finished.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Vorgang verwendet bereits %@. Bitte warten Sie, bis er beendet ist."
