{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld"
          }
        }
      }
    },
    "About %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über %@"
          }
        }
      }
    },
