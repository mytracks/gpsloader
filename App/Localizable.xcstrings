        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
    },
    "Connect the logger with its USB cable. No port needs to be chosen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie den Logger mit seinem USB-Kabel an. Ein Anschluss muss nicht gewählt werden."
