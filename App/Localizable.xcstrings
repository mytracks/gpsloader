        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Daten auf %@ löschen?"
          }
        }
      }
    },
    "Erased data cannot be recovered. Save the data first if you still need it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Daten können nicht wiederhergestellt werden. Sichern Sie die Daten vorher, wenn Sie sie noch benötigen."
          }
        }
      }
    },
    "Erasing %@…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird gelöscht …"
