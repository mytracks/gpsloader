          "stringUnit": {
            "state": "translated",
            "value": "Treiberseite des Herstellers öffnen"
          }
        }
      }
    },
    "Pair the %@ in System Settings > Bluetooth first. myTracks Loader then connects to it by itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie den %@ zuerst in den Systemeinstellungen unter „Bluetooth“. myTracks Loader verbindet sich dann selbst mit ihm."
