      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienste"
          }
        }
      }
    },
    "Show All": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle einblenden"
          }
        }
      }
    },
    "The GPX file has been saved. Some data was skipped:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die GPX-Datei wurde gespeichert. Einige Daten wurden übersprungen:"
          }
        }
      }
    },
    "The capture contains all data exchanged with the device, including recorded positions. Only send it to people you trust, for example the developer of gpsloader.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mitschnitt enthält alle mit dem Gerät ausgetauschten Daten, einschließlich der aufgezeichneten Positionen. Senden Sie ihn nur an Personen, denen Sie vertrauen, zum Beispiel an den Entwickler von gpsloader."
          }
        }
      }
    },
    "The data has been erased.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten wurden gelöscht."
          }
        }
      }
    },
    "The first start under Rosetta can take a few seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Start unter Rosetta kann einige Sekunden dauern."
          }
        }
      }
    },
    "The format of %lld files is not supported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Format von %lld Dateien wird nicht unterstützt."
          }
        }
      }
    },
    "The format of the chosen files is not supported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Format der gewählten Dateien wird nicht unterstützt."
          }
        }
      }
    },
    "The format of “%@” is not supported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Format von „%@“ wird nicht unterstützt."
          }
        }
      }
    },
    "The logger does not contain any data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Logger enthält keine Daten."
          }
        }
      }
    },
    "The system dialog for installing Rosetta could not be opened. Open Terminal, enter the following command and confirm with your administrator password:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Systemdialog zur Installation von Rosetta konnte nicht geöffnet werden. Öffnen Sie das Terminal, geben Sie den folgenden Befehl ein und bestätigen Sie mit Ihrem Administratorpasswort:"
          }
        }
      }
    },
    "Third-party software": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Software von Drittanbietern"
          }
        }
      }
    },
    "Version %@ (%@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ (%2$@)"
          }
        }
      }
    },
    "Warning: Erasing is experimental for this device. It has not been tested with a real device and might fail or leave the logger in an unusable state.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung: Das Löschen ist für dieses Gerät experimentell. Es wurde nicht mit einem echten Gerät getestet und könnte fehlschlagen oder den Logger in einem unbrauchbaren Zustand hinterlassen."
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster"
          }
        }
      }
    },
    "gpsbabel cannot be started": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gpsbabel kann nicht gestartet werden"
          }
        }
      }
    },
    "gpsloader includes GPSBabel 1.7.0 (copyright the GPSBabel authors), distributed under the GNU General Public License version 2 or later. GPSBabel runs as a separate program and uses Qt Core 5.12.9 (copyright The Qt Company Ltd. and other contributors), distributed under the GNU Lesser General Public License version 3. The complete source code of both is available at the links below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gpsloader enthält GPSBabel 1.7.0 (Copyright der GPSBabel-Autoren), verbreitet unter der GNU General Public License Version 2 oder neuer. GPSBabel läuft als eigenständiges Programm und verwendet Qt Core 5.12.9 (Copyright The Qt Company Ltd. und weitere Mitwirkende), verbreitet unter der GNU Lesser General Public License Version 3. Der vollständige Quellcode beider Projekte ist über die folgenden Links erhältlich."
          }
        }
      }
    }
  },
  "version": "1.0"
}
