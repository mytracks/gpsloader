{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld"
          }
        }
      }
    },
    "About %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über %@"
          }
        }
      }
    },
    "About gpsloader": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über gpsloader"
          }
        }
      }
    },
    "All supported devices can be used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle unterstützten Geräte können verwendet werden."
          }
        }
      }
    },
    "Another operation is already using %@. Wait until it has finished.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Vorgang verwendet bereits %@. Bitte warten Sie, bis er beendet ist."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Cancelling…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird abgebrochen …"
          }
        }
      }
    },
    "Check Again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut prüfen"
          }
        }
      }
    },
    "Checking gpsbabel…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gpsbabel wird geprüft …"
          }
        }
      }
    },
    "Choose one or more files to convert to GPX.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine oder mehrere Dateien, die nach GPX konvertiert werden sollen."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortfahren"
          }
        }
      }
    },
    "Continue Without These Files": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne diese Dateien fortfahren"
          }
        }
      }
    },
    "Continue Without This File": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne diese Datei fortfahren"
          }
        }
      }
    },
