{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld"
          }
        }
      }
    },
    "A USB device with a %@ chip is connected, but macOS has not created a port for it. The driver is probably missing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein USB-Gerät mit einem Chip von %@ ist angeschlossen, aber macOS hat keinen Anschluss dafür angelegt. Vermutlich fehlt der Treiber."
          }
        }
      }
    },
    "About %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über %@"
          }
        }
      }
    },
    "Another operation is already using %@. Wait until it has finished.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Vorgang verwendet bereits %@. Bitte warten Sie, bis er beendet ist."
          }
        }
      }
    },
