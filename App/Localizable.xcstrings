    "Device:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerät:"
          }
        }
      }
    },
    "Diagnostic captures contain all data exchanged with the device, including recorded positions. Only send the package to people you trust, for example the developer of myTracks Loader.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose-Mitschnitte enthalten alle mit dem Gerät ausgetauschten Daten, auch die aufgezeichneten Positionen. Schicken Sie das Paket nur an Personen, denen Sie vertrauen, zum Beispiel an den Entwickler von myTracks Loader."
          }
        }
      }
    },
    "Diagnostic captures of the last operations (%lld)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose-Mitschnitte der letzten Vorgänge (%lld)"
          }
        }
      }
    },
    "Drag Files Here": {
      "localizations": {
        "de": {
          "stringUnit": {
