        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablage"
          }
        }
      }
    },
    "Files from memory cards or USB storage are converted to one GPX file. Supported formats: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien von Speicherkarte oder USB-Speicher werden zu einer GPX-Datei konvertiert. Unterstützte Formate: %@."
