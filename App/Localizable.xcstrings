      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konvertieren"
          }
        }
      }
    },
    "Convert Files…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien konvertieren …"
          }
        }
      }
    },
    "Convert files from memory cards or USB storage to GPX. Supported formats: %@. You can also drag files onto this window.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien von Speicherkarte oder USB-Speicher nach GPX konvertieren. Unterstützte Formate: %@. Sie können Dateien auch auf dieses Fenster ziehen."
          }
        }
      }
    },
    "Converting files…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden konvertiert …"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren"
          }
        }
      }
    },
    "Copy Command": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehl kopieren"
          }
        }
      }
    },
    "Details: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Details: %@"
          }
        }
      }
    },
    "Device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerät"
          }
        }
      }
    },
    "Device drivers will be added in upcoming versions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerätetreiber folgen in kommenden Versionen."
          }
        }
      }
    },
    "Devices that use gpsbabel only work after Rosetta has been installed. Devices with built-in drivers work without Rosetta.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte, die gpsbabel nutzen, funktionieren erst nach der Installation von Rosetta. Geräte mit eingebauten Treibern funktionieren auch ohne Rosetta."
          }
        }
      }
    },
    "Diagnostics": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose"
          }
        }
      }
    },
    "Edit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeiten"
          }
        }
      }
    },
