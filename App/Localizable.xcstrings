            "value": "Darstellung"
          }
        }
      }
    },
    "Warning: Erasing is experimental for this device. It has not been tested with a real device and might fail or leave the logger in an unusable state.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung: Das Löschen ist für dieses Gerät experimentell. Es wurde nicht mit einem echten Gerät getestet und könnte fehlschlagen oder den Logger in einem unbrauchbaren Zustand hinterlassen."
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster"
          }
        }
      }
    },
    "myTracks Loader contains GPSLoggerKit (copyright 2026 Dirk Stichling), distributed under the MIT License. Its source code is part of the source code of myTracks Loader.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "myTracks Loader enthält GPSLoggerKit (Copyright 2026 Dirk Stichling), verbreitet unter der MIT-Lizenz. Sein Quellcode ist Teil des Quellcodes von myTracks Loader."
          }
        }
      }
    },
    "myTracks Loader is free software, distributed under the GNU General Public License version 3 or later. You may redistribute and modify it under the terms of that license.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
