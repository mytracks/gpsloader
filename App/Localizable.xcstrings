      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System- und App-Informationen"
          }
        }
      }
    },
    "The %@ cannot be read reliably over Bluetooth. Connect it with the USB cable and choose its USB port.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der %@ lässt sich über Bluetooth nicht zuverlässig auslesen. Verbinden Sie ihn mit dem USB-Kabel und wählen Sie seinen USB-Anschluss."
          }
        }
      }
    },
    "The GPX file has been saved. Some data was skipped:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die GPX-Datei wurde gespeichert. Einige Daten wurden übersprungen:"
          }
        }
      }
    },
    "The data has been erased.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten wurden gelöscht."
          }
        }
      }
    },
    "The format of %lld files is not supported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Format von %lld Dateien wird nicht unterstützt."
          }
        }
      }
    },
    "The format of the chosen files is not supported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Format der gewählten Dateien wird nicht unterstützt."
          }
        }
      }
    },
    "The format of “%@” is not supported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Format von „%@“ wird nicht unterstützt."
          }
        }
      }
    },
    "The logger does not contain any data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Logger enthält keine Daten."
          }
        }
      }
    },
    "The support package collects information that helps the developer analyze a problem. It is only saved on your Mac; you decide whom to send it to.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Support-Paket sammelt Informationen, mit denen der Entwickler ein Problem untersuchen kann. Es wird nur auf Ihrem Mac gesichert; Sie entscheiden, wem Sie es schicken."
          }
        }
      }
    },
    "Third-party software": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Software von Drittanbietern"
          }
        }
      }
    },
